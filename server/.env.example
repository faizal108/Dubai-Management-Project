# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins. In Azure, set this to the
# frontend Container App's HTTPS URL (e.g. https://ca-donation-frontend.<env-domain>).
CORS_ORIGIN=http://localhost:5173

# Database
# Local/docker-compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/donation_platform?schema=public
# Azure Database for PostgreSQL Flexible Server requires SSL — append sslmode=require:
# DATABASE_URL=postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/donation_platform?schema=public&sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Seed superadmin (used by prisma/seed.js only)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe@123
