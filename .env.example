# Root .env consumed by docker-compose. Copy to .env and adjust.
# Everything here is also overridable on the docker-compose command line.

# ---- Environment ----
NODE_ENV=production
LOG_LEVEL=info

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=donation_platform
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Seed superadmin (only used by the migrator service on first boot)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe@123

# ---- Frontend ----
FRONTEND_PORT=3000
# Must include /api/v1 — this is baked into the Vite bundle at build time.
VITE_API_BASE_URL=http://localhost:4000/api/v1
