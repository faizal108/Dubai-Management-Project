.vite
.cache
.parcel-cache
.turbo

# Prisma — keep schema.prisma and migrations/, ignore local generated artifacts
server/prisma/*.db
server/prisma/*.db-journal

# Test / coverage
coverage
*.lcov
.nyc_output

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

