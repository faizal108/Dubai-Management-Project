# Base URL of the backend API. Must include the /api/v1 prefix.
# This is a Vite build-time value — it gets baked into the JS bundle, so it
# must be passed as a --build-arg (or ARG in CI) at image build time, not set
# as a runtime env var on the running container.
# Local dev:   http://localhost:4000/api/v1
# Docker dev:  http://localhost:4000/api/v1 (host port mapped by docker-compose)
# Azure:       https://ca-donation-backend.<container-apps-env-domain>/api/v1
#              (the backend Container App's public FQDN — frontend calls it
#              directly over HTTPS; nginx does not proxy in this setup)
VITE_API_BASE_URL=http://localhost:4000/api/v1
